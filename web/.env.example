# Copy to .env.local and fill in from your Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_, never ship to the browser.
# Only used by server-side code that must bypass RLS (there is currently no
# server route in web/ that needs this; Edge Functions use their own copy
# via `supabase secrets`). Kept here for completeness/local scripting.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
